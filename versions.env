# ═══════════════════════════════════════════════════════════════════
# MAA 官方核心版本钉死表 —— CI 与本地构建的唯一真相
#
# 为什么单独放一个文件：
#   GitHub Actions 与本地 `bash deploy/build.sh` 必须拿到**同一份**核心包，
#   否则「CI 构建出来的」和「本地验证过的」就是两个东西。两边都只读这里。
#
# 升级流程：
#   1. 改 MAA_CORE_VERSION
#   2. 用 `bash deploy/fetch-maa-core.sh --print-sha256` 拿到新包的摘要，
#      填进 MAA_CORE_SHA256（务必是真值，不是占位符）
#   3. 本地跑一次 build，确认能过
#   4. 提交。CI 会用同一个版本、同一个摘要去校验。
#
# 兜底 URL 的用途：Releases 资源偶尔需要走镜像；主 URL 失败时才尝试。
# 两者必须指向**同一个文件**（摘要相同），否则校验会失败 —— 这是有意的。
# ═══════════════════════════════════════════════════════════════════

# 不带前导 v（脚本自己拼）。必须与 MaaAssistantArknights 的 Release tag 一致。
MAA_CORE_VERSION=v6.17.5

# 摘要来源：sha256sum maa-linux.tar.gz
MAA_CORE_SHA256=__FILL_ME__

# ── 可选项（一般不用改）───────────────────────────────────────────
# 官方 Linux 包名模板。{version} 会被替换成 MAA_CORE_VERSION。
MAA_CORE_ASSET_TEMPLATE=MAA-{version}-linux-x86_64.tar.gz

# 下载地址模板。{version} / {asset} 会被替换。
MAA_CORE_URL_TEMPLATE=https://github.com/MaaAssistantArknights/MaaAssistantArknights/releases/download/{version}/{asset}

# 主 URL 失败时的镜像（指向同一个 asset、同一份内容）。
MAA_CORE_URL_FALLBACK_TEMPLATE=https://mirrorchyan.com/api/resources/MAA/releases/download/{version}/{asset}?cdk=

# 下载目标文件名（downloader 落地后 build.sh 读它）。
MAA_TARBALL_NAME=maa-linux.tar.gz
